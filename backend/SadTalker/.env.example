# API Key Configuration for OpenTalking / SadTalker / ViEneu Backend

# AI reply provider: gemini (default) or claude
# AI_PROVIDER=gemini

# Gemini API key (used when AI_PROVIDER=gemini, the default)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude) API key (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Only if your key is workspace-scoped / identity-linked (Console -> Settings -> Workspaces):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional: override the Claude model / effort (defaults: claude-opus-5, low)
# AI_PROVIDER=gemini   # or: claude
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_EFFORT=low
# Optional: Whisper model for live-mic speech-to-text (default openai/whisper-small)
# WHISPER_MODEL=openai/whisper-small

# Startup warm-up: load all models before serving so no request pays first-load cost.
# WARMUP=all (default) | off | comma list e.g. sadtalker,vieneu,voxcpm,whisper
# WARMUP=all
# Keep SadTalker models loaded in-process instead of a fresh subprocess per request:
# SADTALKER_WARM=1

# Remove.bg API Key for automatic avatar background removal (optional)
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# ElevenLabs API Key for custom voice cloning (VoxCPM reference) and the
# Speech-to-Speech Voice Changer feature (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
