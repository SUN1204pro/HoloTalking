# ============================================================================
#  OpenTalking / SadTalker / ViEneu backend configuration
#  Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.
# ============================================================================

# --- AI reply -----------------------------------------------------------------
# Which service generates the avatar's reply: gemini (default) or claude
AI_PROVIDER=gemini

# Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude / Anthropic (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Required only if your Anthropic key is workspace-scoped / identity-linked
# (Console -> Settings -> Workspaces). Plain keys don't need this.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Override model / reasoning effort (defaults: claude-opus-5, low)
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_EFFORT=low
# How many past messages of memory to send to the model (default 20)
# CLAUDE_HISTORY_TURNS=20

# --- Speech-to-text (live-mic, claude provider only) -------------------------
# WHISPER_MODEL=openai/whisper-small       # or: openai/whisper-medium, vinai/PhoWhisper-medium

# --- Startup / performance ---------------------------------------------------
# Preload all models at boot so no request pays the first-load cost.
# WARMUP=all (default) | off | comma list e.g. sadtalker,vieneu,voxcpm,whisper
# WARMUP=all
# Keep SadTalker loaded in-process instead of a fresh subprocess per request (default on)
# SADTALKER_WARM=1
# Force SadTalker / Wav2Lip onto CPU
# SADTALKER_FORCE_CPU=1
# TTS device override: cuda | cpu | mps  (auto-detected by default)
# TTS_DEVICE=cuda

# --- Networking ------------------------------------------------------------
# Base URL other devices (phone on same Wi-Fi) use to reach this server
# PUBLIC_BASE_URL=http://192.168.1.50:8000
# Use IPv4 only for outbound API calls (fixes Gemini "Read timed out" when IPv6 is broken)
# FORCE_IPV4=1

# --- Optional integrations --------------------------------------------------
# Remove.bg API key for automatic avatar background removal
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# ElevenLabs API key for voice cloning (VoxCPM reference) + Voice Changer
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
